{% import '@erm/_help.html.twig' as help %}
{{ help.box(__('What is the treatment plan for?', 'erm'), [
   __('Each action reduces the probability or the impact of the risk. It needs a responsible, a due date and, if possible, an estimated cost.', 'erm'),
   __('The responsible receives an e-mail when the action is assigned and reminders before and after the due date.', 'erm'),
   __('When all actions are done, update the residual risk in the main tab: the effectiveness panel shows if the target was reached.', 'erm')
], __('Example: "Implement biometric identity validation in the app" - responsible: Head of Digital Channels - due: 30/06.', 'erm')) }}
{% set eval_labels = {
   'reached': [__('Target reached', 'erm'), 'bg-green-lt'],
   'in_progress': [__('Treatment in progress', 'erm'), 'bg-blue-lt'],
   'ineffective': [__('Plan completed, target not reached: review the plan or the controls', 'erm'), 'bg-red-lt'],
   'no_plan': [__('Above target without plan', 'erm'), 'bg-red-lt'],
   'no_target': [__('Define the target risk in the main tab to measure the effectiveness of the treatment.', 'erm'), 'bg-secondary-lt']} %}
<div class="card mb-3">
   <div class="card-header"><h3 class="card-title"><i class="ti ti-target-arrow me-2"></i>{{ __('Treatment effectiveness', 'erm') }}</h3></div>
   <div class="card-body">
      <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
         {# badges built by Scale::badge() (escaped) #}
         <span class="small text-muted">{{ __('Inherent', 'erm') }}</span> {{ eval.inherent|raw }} <i class="ti ti-arrow-right"></i>
         <span class="small text-muted">{{ __('Residual', 'erm') }}</span> {{ eval.residual|raw }} <i class="ti ti-arrow-right"></i>
         <span class="small text-muted">{{ __('Target', 'erm') }}</span> {{ eval.target|raw }}
         {% if eval.target_date %}<span class="small text-muted">({{ eval.target_date }})</span>{% endif %}
         <span class="badge {{ eval_labels[eval.key][1] }} ms-auto">{{ eval_labels[eval.key][0] }}</span>
      </div>
      <div class="d-flex align-items-center gap-2">
         <div class="progress flex-grow-1" style="height:10px"><div class="progress-bar bg-primary" style="width:{{ eval.progress }}%"></div></div>
         <span class="small text-muted text-nowrap">{{ __('%1$d of %2$d actions closed', 'erm')|format(eval.closed, eval.total) }}</span>
      </div>
   </div>
</div>
<div class="card">
   <div class="card-header"><h3 class="card-title"><i class="ti ti-list-check me-2"></i>{{ __('Treatment plan', 'erm') }}</h3></div>
   <div class="table-responsive">
      <table class="table table-hover card-table">
         <thead><tr><th>{{ __('Action', 'erm') }}</th><th>{{ __('Responsible', 'erm') }}</th><th>{{ __('Due date', 'erm') }}</th><th>{{ __('Estimated cost', 'erm') }}</th><th>{{ __('Status', 'erm') }}</th><th>{{ __('Done on', 'erm') }}</th>{% if can_purge %}<th></th>{% endif %}</tr></thead>
         <tbody>
         {% for r in rows %}
            <tr>
               <td>{{ r.name }}</td>
               <td>{{ r.owner }}</td>
               <td>{% if r.overdue %}<span class="badge bg-red-lt"><i class="ti ti-alarm"></i> {{ r.due_date }} {{ __('overdue', 'erm') }}</span>{% else %}{{ r.due_date }}{% endif %}</td>
               <td>{{ r.cost is not null ? r.cost|formatted_number : '-' }}</td>
               {% if can_edit %}
               <td colspan="2">
                  <form method="post" action="{{ action }}" class="d-flex gap-1">
                     <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                     <input type="hidden" name="id" value="{{ r.id }}">
                     <select name="status" class="form-select form-select-sm">
                        {% for k, v in statuses %}<option value="{{ k }}" {{ k == r.status ? 'selected' }}>{{ v }}</option>{% endfor %}
                     </select>
                     <input type="date" name="completion_date" value="{{ r.completion_date }}" class="form-control form-control-sm">
                     <button type="submit" name="update" class="btn btn-sm btn-outline-primary" title="{{ __('Save', 'erm') }}"><i class="ti ti-device-floppy"></i></button>
                  </form>
               </td>
               {% else %}
               <td>{{ statuses[r.status] ?? r.status }}</td><td>{{ r.completion_date }}</td>
               {% endif %}
               {% if can_purge %}
               <td>
                  <form method="post" action="{{ action }}">
                     <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                     <input type="hidden" name="id" value="{{ r.id }}">
                     <button type="submit" name="purge" class="btn btn-sm btn-ghost-danger" title="{{ __('Delete', 'erm') }}"><i class="ti ti-trash"></i></button>
                  </form>
               </td>
               {% endif %}
            </tr>
         {% else %}
            <tr><td colspan="7" class="text-muted">{{ __('No actions yet. Add what will be done to reduce the risk, who is responsible and by when. A risk to be mitigated or transferred needs at least one action.', 'erm') }}</td></tr>
         {% endfor %}
         </tbody>
      </table>
   </div>
   {% if can_add %}
   <div class="card-footer">
      <form method="post" action="{{ action }}" class="row g-2 align-items-end">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <input type="hidden" name="plugin_erm_risks_id" value="{{ risk.getID() }}">
         <div class="col-md-4"><label class="form-label">{{ __('New action', 'erm') }}</label><input type="text" name="name" class="form-control" required></div>
         <div class="col-md-2"><label class="form-label">{{ __('Responsible', 'erm') }}</label>{{ call('User::dropdown', [{'name': 'users_id', 'right': 'all', 'display': false, 'entity': risk.fields['entities_id']}])|raw }}</div>
         <div class="col-md-2"><label class="form-label">{{ __('Due date', 'erm') }}</label><input type="date" name="due_date" class="form-control"></div>
         <div class="col-md-2"><label class="form-label">{{ __('Estimated cost', 'erm') }}</label><input type="text" inputmode="decimal" name="cost" class="form-control"></div>
         <div class="col-md-2"><button type="submit" name="add" class="btn btn-primary w-100"><i class="ti ti-plus"></i> {{ __('Add', 'erm') }}</button></div>
      </form>
   </div>
   {% endif %}
</div>
