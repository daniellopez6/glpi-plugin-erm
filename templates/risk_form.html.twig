{# Formulario del riesgo corporativo (ERM) #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
   {% if acceptance_only %}
   <div class="alert alert-info col-12"><i class="ti ti-gavel me-2"></i>Tu perfil (Comité de riesgos) sólo puede registrar la decisión de tratamiento, el estado y la justificación. La evaluación la mantiene el dueño del riesgo.</div>
   {% endif %}
   <fieldset {{ acceptance_only ? 'disabled' }} style="display:contents">
   {{ fields.smallTitle('Identificación', 'ti ti-id') }}
   {{ fields.textField('code', item.fields['code'], 'Código', {'helper': 'Se asigna automáticamente (RC-001...) si se deja vacío.'}) }}
   {{ fields.textField('name', item.fields['name'], 'Riesgo', {'required': true}) }}
   {{ fields.dropdownField('GlpiPlugin\\Erm\\Category', 'plugin_erm_categories_id', item.fields['plugin_erm_categories_id'], 'Categoría', {'entity': item.fields['entities_id']}) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], 'Dueño del riesgo', {'right': 'all', 'entity': item.fields['entities_id']}) }}
   {{ fields.dropdownField('Group', 'groups_id', item.fields['groups_id'], 'Área responsable', {'entity': item.fields['entities_id']}) }}
   {{ fields.textareaField('description', item.fields['description'], 'Descripción del evento de riesgo', {'full_width': true}) }}
   {{ fields.textareaField('causes', item.fields['causes'], 'Causas', {'full_width': true}) }}
   {{ fields.textareaField('consequences', item.fields['consequences'], 'Consecuencias', {'full_width': true}) }}

   {{ fields.smallTitle('Evaluación inherente (sin controles)', 'ti ti-flame') }}
   {{ fields.dropdownArrayField('inherent_probability', item.fields['inherent_probability'] ?? 0, probabilities, 'Probabilidad') }}
   {{ fields.dropdownArrayField('inherent_impact', item.fields['inherent_impact'] ?? 0, impacts, 'Impacto') }}
   {{ fields.htmlField('', inherent_badge, 'Nivel inherente') }}
   {{ fields.dropdownArrayField('velocity', item.fields['velocity'], velocities, 'Velocidad de materialización') }}
   {{ fields.numberField('economic_impact_min', item.fields['economic_impact_min'], 'Impacto económico mínimo (ARS)', {'step': 'any'}) }}
   {{ fields.numberField('economic_impact_max', item.fields['economic_impact_max'], 'Impacto económico máximo (ARS)', {'step': 'any'}) }}

   {{ fields.smallTitle('Controles existentes y riesgo residual', 'ti ti-shield-check') }}
   {{ fields.textareaField('existing_controls', item.fields['existing_controls'], 'Controles existentes', {'full_width': true}) }}
   {{ fields.dropdownArrayField('control_effectiveness', item.fields['control_effectiveness'], effectiveness, 'Eficacia de los controles') }}
   {{ fields.dropdownArrayField('trend', item.fields['trend'], trends, 'Tendencia') }}
   {{ fields.dropdownArrayField('residual_probability', item.fields['residual_probability'] ?? 0, probabilities, 'Probabilidad residual') }}
   {{ fields.dropdownArrayField('residual_impact', item.fields['residual_impact'] ?? 0, impacts, 'Impacto residual') }}
   {{ fields.htmlField('', residual_badge, 'Nivel residual') }}
   {% if appetite_badge %}
      {{ fields.htmlField('', appetite_badge, 'Posición frente al apetito') }}
   {% endif %}
   </fieldset>

   {{ fields.smallTitle('Tratamiento y aceptación', 'ti ti-checklist') }}
   {{ fields.dropdownArrayField('treatment', item.fields['treatment'], treatments, 'Decisión de tratamiento') }}
   {{ fields.dropdownArrayField('status', item.fields['status'] ?: 'identified', statuses, 'Estado') }}
   {{ fields.textareaField('justification', item.fields['justification'], 'Justificación de la decisión', {'full_width': true}) }}
   {{ fields.htmlField('', acceptance, 'Aceptación formal', {
      'helper': can_accept
         ? 'Para aceptar: decisión "Aceptar" y estado "Aceptado". Se registra automáticamente quién y cuándo. El dueño del riesgo no puede aceptarlo.'
         : 'Sólo el Comité de riesgos o el Directorio (permiso "Aceptación de riesgos") puede aceptar formalmente un riesgo.'
   }) }}
   {{ fields.dateField('review_date', item.fields['review_date'], 'Próxima revisión') }}
   {{ fields.dateField('last_review_date', item.fields['last_review_date'], 'Última revisión') }}
{% endblock %}
