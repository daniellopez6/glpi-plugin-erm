<div class="container-fluid">
   <div class="row row-cards">
      <div class="col-lg-6">
         <div class="card">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-speakerphone me-2"></i>{{ __('Report a risk or an incident', 'erm') }}</h3></div>
            <div class="card-body">
               <p class="text-muted small">{{ __('Anyone can report something that went wrong, almost went wrong or could go wrong: a mistake, a fraud attempt, a complaint, a supplier failure, an unsafe practice... The risk team reviews every report. Reporting in good faith is never penalized.', 'erm') }}</p>
               <form method="post" action="{{ action }}">
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                  <div class="mb-2"><label class="form-label">{{ __('What do you want to report?', 'erm') }}</label>
                     {% for k, v in types %}<label class="form-check"><input class="form-check-input" type="radio" name="report_type" value="{{ k }}" {{ loop.first ? 'checked' }}><span class="form-check-label">{{ v }}</span></label>{% endfor %}</div>
                  <div class="mb-2"><label class="form-label required">{{ __('Title', 'erm') }}</label><input type="text" name="name" maxlength="255" class="form-control" required></div>
                  <div class="mb-2"><label class="form-label required">{{ __('What happened or could happen, and why it matters', 'erm') }}</label><textarea name="description" rows="4" class="form-control" required></textarea></div>
                  <div class="row g-2 mb-2">
                     <div class="col-md-4"><label class="form-label">{{ __('Date (if it happened)', 'erm') }}</label><input type="date" name="occurrence_date" max="{{ today }}" class="form-control"></div>
                     <div class="col-md-4"><label class="form-label">{{ __('Estimated loss (optional)', 'erm') }}</label><input type="text" inputmode="decimal" name="estimated_loss" class="form-control"></div>
                     <div class="col-md-4"><label class="form-label">{{ __('Area or process', 'erm') }}</label><input type="text" name="area" maxlength="255" class="form-control"></div>
                  </div>
                  <button type="submit" name="submit_report" class="btn btn-primary"><i class="ti ti-send me-1"></i>{{ __('Send report', 'erm') }}</button>
               </form>
            </div>
         </div>
      </div>
      <div class="col-lg-6">
         <div class="card">
            <div class="card-header"><h3 class="card-title">{{ __('My reports', 'erm') }}</h3></div>
            <div class="table-responsive"><table class="table card-table table-sm">
               <thead><tr><th>{{ __('Date', 'erm') }}</th><th>{{ __('Title', 'erm') }}</th><th>{{ __('Status', 'erm') }}</th></tr></thead>
               <tbody>
               {% for r in mine %}
                  <tr><td class="small text-nowrap">{{ r.date_creation|slice(0, 10) }}</td><td>{{ r.name }}{% if r.review_comment %}<div class="small text-muted">{{ r.review_comment }}</div>{% endif %}</td>
                     <td><span class="badge {{ r.status == 'converted' ? 'bg-green-lt' : (r.status == 'rejected' ? 'bg-secondary-lt' : 'bg-blue-lt') }}">{{ r.status_label }}</span></td></tr>
               {% else %}<tr><td colspan="3" class="text-muted">{{ __('You have not sent any report.', 'erm') }}</td></tr>{% endfor %}
               </tbody></table></div>
         </div>
      </div>
   </div>

   {% if can_review %}
   <div class="card mt-3">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-inbox me-2"></i>{{ __('Reports to review', 'erm') }} <span class="badge bg-blue-lt ms-2">{{ inbox|length }}</span></h3></div>
      <div class="table-responsive"><table class="table card-table table-vcenter">
         <thead><tr><th>{{ __('Date', 'erm') }}</th><th>{{ __('Report', 'erm') }}</th><th>{{ __('Reported by', 'erm') }}</th><th>{{ __('Action', 'erm') }}</th></tr></thead>
         <tbody>
         {% for r in inbox %}
            <tr>
               <td class="small text-nowrap">{{ r.date_creation|slice(0, 10) }}{% if r.occurrence_date %}<div class="text-muted">{{ __('occurred', 'erm') }} {{ r.occurrence_date }}</div>{% endif %}</td>
               <td><b>{{ r.name }}</b> <span class="badge bg-secondary-lt">{{ types[r.report_type] ?? r.report_type }}</span>
                  <div class="small">{{ r.description|nl2br }}</div>
                  <div class="small text-muted">{{ r.entity }}{% if r.area %} · {{ r.area }}{% endif %}{% if r.estimated_loss is not null %} · {{ __('Estimated loss', 'erm') }}: {{ r.estimated_loss|formatted_number }}{% endif %}</div></td>
               <td class="small">{{ r.reporter }}</td>
               <td>
                  <form method="post" action="{{ action }}" class="d-flex flex-column gap-1" style="min-width:14rem">
                     <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                     <input type="hidden" name="id" value="{{ r.id }}">
                     {% if can_event and r.report_type != 'risk' %}<button type="submit" name="to_event" class="btn btn-sm btn-outline-primary"><i class="ti ti-flame me-1"></i>{{ __('Record as loss event', 'erm') }}</button>{% endif %}
                     {% if can_risk %}<button type="submit" name="to_risk" class="btn btn-sm btn-outline-primary"><i class="ti ti-shield-plus me-1"></i>{{ __('Register as corporate risk', 'erm') }}</button>{% endif %}
                     <div class="input-group input-group-sm"><input type="text" name="review_comment" class="form-control" placeholder="{{ __('Reason to close', 'erm') }}"><button type="submit" name="reject" class="btn btn-outline-secondary">{{ __('Close', 'erm') }}</button></div>
                  </form>
               </td>
            </tr>
         {% else %}<tr><td colspan="4" class="text-muted">{{ __('No pending reports.', 'erm') }}</td></tr>{% endfor %}
         </tbody></table></div>
   </div>
   {% endif %}
</div>
