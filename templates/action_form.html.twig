{# Treatment action form #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
   {% if risk %}
   {{ fields.htmlField('', '<a href="' ~ risk.getLinkURL() ~ '"><b>' ~ risk.fields['code']|e ~ '</b> ' ~ risk.fields['name']|e ~ '</a>', __('Risk', 'erm')) }}
   {% endif %}
   {{ fields.textareaField('name', item.fields['name'], __('Action', 'erm'), {'required': true, 'full_width': true}) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], __('Responsible', 'erm'), {'right': 'all', 'entity': item.fields['entities_id']}) }}
   {{ fields.dateField('due_date', item.fields['due_date'], __('Due date', 'erm'), {'helper': overdue ? __('Overdue', 'erm') : ''}) }}
   {{ fields.dropdownArrayField('status', item.fields['status'], statuses, __('Status', 'erm')) }}
   {{ fields.dateField('completion_date', item.fields['completion_date'], __('Done on', 'erm')) }}
   {{ fields.textField('cost', item.fields['cost'], __('Estimated cost', 'erm'), {'helper': __('In the currency of the organization.', 'erm')}) }}
   {{ fields.textareaField('comment', item.fields['comment'], __('Comments'), {'full_width': true}) }}
{% endblock %}
