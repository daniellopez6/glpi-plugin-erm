{% macro heatmap(title, kind, data, cells, prob_labels, imp_labels, drill_url) %}
<div class="card h-100">
   <div class="card-header"><h3 class="card-title">{{ title }}</h3></div>
   <div class="card-body">
      <table class="erm-heat" style="width:100%;border-collapse:separate;border-spacing:3px">
         {% for p in 5..1 %}
         <tr>
            <th class="text-end small text-muted pe-2" style="width:30%;font-weight:normal">{{ prob_labels[p] }}</th>
            {% for i in 1..5 %}
               {% set codes = data[p][i] ?? [] %}
               <td style="background:{{ cells[p][i] }};height:52px;border-radius:6px;text-align:center;vertical-align:middle;color:{{ cells[p][i] == '#f5c518' ? '#1d273b' : '#fff' }}"
                   title="{{ codes|join(', ') }}">
                  {% if codes|length %}<a href="{{ drill_url }}&{{ {'heat': kind, 'p': p, 'i': i}|url_encode }}" class="erm-drill d-block text-reset text-decoration-none"><div style="font-size:1.4rem;font-weight:700;line-height:1">{{ codes|length }}</div><div style="font-size:.65rem">{{ codes|slice(0,3)|join(' ') }}{{ codes|length > 3 ? '…' }}</div></a>{% endif %}
               </td>
            {% endfor %}
         </tr>
         {% endfor %}
         <tr><th></th>{% for i in 1..5 %}<th class="small text-muted text-center" style="font-weight:normal">{{ imp_labels[i] }}</th>{% endfor %}</tr>
      </table>
      <div class="text-center small text-muted mt-1">{{ __('Probability (rows) × Impact (columns)', 'erm') }}</div>
   </div>
</div>
{% endmacro %}
{% import _self as m %}
<style>
   .erm-drill { cursor: pointer; }
   a.erm-card { color: inherit; text-decoration: none; display: block; height: 100%; }
   a.erm-card .card { transition: box-shadow .15s, transform .15s; }
   a.erm-card:hover .card { box-shadow: 0 .25rem .75rem rgba(0,0,0,.12); transform: translateY(-1px); }
   .erm-heat a.erm-drill:hover { text-decoration: underline !important; }
</style>

<div class="container-fluid">
   <div class="alert alert-info d-flex">
      <i class="ti ti-info-circle me-2 fs-2"></i>
      <div>
         <b>{{ __('Enterprise risk management (ERM)', 'erm') }}</b>:
         {{ __('strategic, financial, operational, compliance, fraud, reputational and ESG risks, assessed with a 5×5 matrix (ISO 31000 / COSO ERM).', 'erm') }}
         {% if grc %}{{ __('Information security risks are managed in detail in the ISMS register (GRC Manager) and can be linked from the "Related items" tab.', 'erm') }}{% endif %}
      </div>
   </div>
   {% if only_own %}
   <div class="alert alert-warning"><i class="ti ti-eye-check me-2"></i>{{ __('Restricted view: only the risks you own, the risks of your groups and those where you have actions or indicators assigned are shown.', 'erm') }}</div>
   {% endif %}

   <div class="row row-cards mb-3">
      <div class="col-sm-6 col-lg-2"><a class="erm-card" href="{{ drill_url }}"><div class="card card-sm"><div class="card-body"><div class="text-muted">{{ __('Active risks', 'erm') }}</div><div class="h1 m-0">{{ total }}</div></div></div></a></div>
      {% for k, label in levels|reverse(true) %}
      <div class="col-sm-6 col-lg-2"><a class="erm-card" href="{{ drill_url }}&level={{ k }}"><div class="card card-sm" style="border-left:6px solid {{ level_color[k] }}"><div class="card-body"><div class="text-muted">{{ __('Residual %s', 'erm')|format(label|lower) }}</div><div class="h1 m-0">{{ by_level[k] }}</div></div></div></a></div>
      {% endfor %}
      <div class="col-sm-6 col-lg-2"><div class="card card-sm"><div class="card-body"><div class="text-muted">{{ __('Maximum economic exposure', 'erm') }}</div><div class="h3 m-0">{{ exposure }}</div></div></div></div>
   </div>

   {% if events %}
   <div class="card mb-3 {{ underestimated|length ? 'border-danger' : '' }}">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-chart-histogram me-2"></i>{{ __('Assessment vs. loss history', 'erm') }}
            {% if underestimated|length %}<a href="{{ drill_url }}&history=1" class="badge bg-red-lt ms-2">{{ underestimated|length }}</a>{% endif %}</h3>
         <div class="card-actions"><span class="text-muted me-3">{{ __('Net losses, last 12 months', 'erm') }}: <b>{{ net_loss_12m }}</b></span><a href="{{ events_url }}">{{ __('Loss event register', 'erm') }}</a></div>
      </div>
      <div class="table-responsive"><table class="table card-table table-sm">
         <thead><tr><th>{{ __('Code', 'erm') }}</th><th>{{ __('Risk', 'erm') }}</th><th class="text-end">{{ __('Loss events', 'erm') }}</th><th>{{ __('Probability (assessed → history)', 'erm') }}</th><th>{{ __('Impact (assessed → history)', 'erm') }}</th></tr></thead>
         <tbody>
         {% for u in underestimated %}
            <tr><td>{{ u.code }}</td><td><a href="{{ risk_url }}?id={{ u.id }}&forcetab=GlpiPlugin%5CErm%5CEvent_Item$1">{{ u.name }}</a></td><td class="text-end">{{ u.losses }}</td>
               {% for d in [u.prob, u.impact] %}
               <td>{% if d[1] %}<span class="{{ d[2] == 'underestimated' ? 'text-danger fw-bold' : '' }}">{{ d[0] }} → {{ d[1] }}</span>{% else %}-{% endif %}</td>
               {% endfor %}
            </tr>
         {% else %}<tr><td colspan="5" class="text-muted">{{ __('No risk is underestimated according to its loss history.', 'erm') }}</td></tr>{% endfor %}
         </tbody></table></div>
   </div>
   {% endif %}

   {% if by_entity|length %}
   <div class="card mb-3">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-building-community me-2"></i>{{ __('Risks by entity', 'erm') }}</h3></div>
      <div class="table-responsive"><table class="table card-table table-sm table-vcenter">
         <thead><tr>
            <th>{{ __('Entity', 'erm') }}</th><th class="text-end">{{ __('Active risks', 'erm') }}</th>
            {% for k, label in levels|reverse(true) %}<th class="text-center">{{ label }}</th>{% endfor %}
            <th class="text-end">{{ __('Outside appetite', 'erm') }}</th><th class="text-end">{{ __('With overdue actions', 'erm') }}</th>
            <th class="text-end">{{ __('With KRIs in alert', 'erm') }}</th><th class="text-end">{{ __('Maximum economic exposure', 'erm') }}</th>
         </tr></thead>
         <tbody>
         {% for e in by_entity %}
            <tr>
               {% set eu = drill_url ~ '&entity=' ~ e.id %}
               <td><a href="{{ eu }}">{{ e.name }}</a></td>
               <td class="text-end"><a href="{{ eu }}">{{ e.count }}</a></td>
               {% for k, label in levels|reverse(true) %}
                  <td class="text-center">{% if e.levels[k] %}<a href="{{ eu }}&level={{ k }}" class="badge text-decoration-none" style="background:{{ level_color[k] }};color:{{ k == 'medium' ? '#1d273b' : '#fff' }}">{{ e.levels[k] }}</a>{% else %}<span class="text-muted">0</span>{% endif %}</td>
               {% endfor %}
               <td class="text-end">{% if e.outside %}<a href="{{ eu }}&outside=any" class="badge bg-orange-lt">{{ e.outside }}</a>{% else %}0{% endif %}</td>
               <td class="text-end">{% if e.overdue %}<a href="{{ eu }}&overdue=1" class="badge bg-red-lt">{{ e.overdue }}</a>{% else %}0{% endif %}</td>
               <td class="text-end">{% if e.kri %}<a href="{{ eu }}&kri=1" class="badge bg-orange-lt">{{ e.kri }}</a>{% else %}0{% endif %}</td>
               <td class="text-end">{{ e.exposure|formatted_number }}</td>
            </tr>
         {% endfor %}
         </tbody>
      </table></div>
   </div>
   {% endif %}

   <div class="row row-cards mb-3">
      <div class="col-lg-6">{{ m.heatmap(__('Heat map - inherent risk', 'erm'), 'inherent', heat.inherent, cells, prob_labels, imp_labels, drill_url) }}</div>
      <div class="col-lg-6">{{ m.heatmap(__('Heat map - residual risk', 'erm'), 'residual', heat.residual, cells, prob_labels, imp_labels, drill_url) }}</div>
   </div>

   <div class="row row-cards mb-3">
      <div class="col-lg-6">
         <div class="card h-100">
            <div class="card-header"><h3 class="card-title">{{ __('Risks and exposure by category', 'erm') }}</h3></div>
            <div class="card-body">
               {% for cat, d in by_cat %}
               <a href="{{ d.url }}" class="d-block mb-2 text-reset text-decoration-none erm-drill">
                  <div class="d-flex justify-content-between small"><b>{{ d.name }}</b><span>{{ _n('%d risk', '%d risks', d.count, 'erm')|format(d.count) }} · {{ d.exposure|formatted_number }}</span></div>
                  <div class="progress" style="height:14px">
                     {% for lvl, n in d.levels %}{% if n %}<div class="progress-bar" style="width:{{ (n / d.count * (d.exposure / max_exp) * 100)|round(1) }}%;background:{{ level_color[lvl] }}" title="{{ levels[lvl] }}: {{ n }}"></div>{% endif %}{% endfor %}
                  </div>
               </a>
               {% endfor %}
               <div class="small text-muted">{{ __('Bar length is proportional to the maximum exposure of the category; colours show the residual level.', 'erm') }}</div>
            </div>
         </div>
      </div>
      <div class="col-lg-6">
         <div class="card h-100">
            <div class="card-header"><h3 class="card-title">{{ __('Outside risk appetite', 'erm') }} <a href="{{ drill_url }}&outside=any" class="badge bg-red-lt ms-2">{{ outside|length }}</a></h3></div>
            <div class="table-responsive"><table class="table card-table table-sm">
               <thead><tr><th>{{ __('Code', 'erm') }}</th><th>{{ __('Risk', 'erm') }}</th><th>{{ __('Category', 'erm') }}</th><th>{{ __('Position', 'erm') }}</th></tr></thead>
               <tbody>
               {% for r in outside %}
                  <tr><td>{{ r.code }}</td><td><a href="{{ risk_url }}?id={{ r.id }}">{{ r.name }}</a></td><td class="small">{{ r.category }}</td>
                      <td><span class="badge {{ r.appetite[0] == 'above_tolerance' ? 'bg-red-lt' : 'bg-orange-lt' }}">{{ r.appetite[1] }}</span></td></tr>
               {% else %}<tr><td colspan="4" class="text-muted">{{ __('All residual risks are within appetite.', 'erm') }}</td></tr>{% endfor %}
               </tbody></table></div>
         </div>
      </div>
   </div>

   <div class="row row-cards mb-3">
      <div class="col-lg-7">
         <div class="card h-100">
            <div class="card-header"><h3 class="card-title">{{ __('Top 10 residual risks', 'erm') }}</h3><div class="card-actions"><a href="{{ list_url }}">{{ __('See full register', 'erm') }}</a></div></div>
            <div class="table-responsive"><table class="table card-table table-sm">
               <thead><tr><th>{{ __('Code', 'erm') }}</th><th>{{ __('Risk', 'erm') }}</th><th>{{ __('Inherent', 'erm') }}</th><th>{{ __('Residual', 'erm') }}</th><th>{{ __('Max. impact', 'erm') }}</th></tr></thead>
               <tbody>
               {% for r in top %}
                  <tr><td>{{ r.code }}</td><td><a href="{{ risk_url }}?id={{ r.id }}">{{ r.name }}</a></td>
                      <td><span class="badge" style="background:{{ level_color[r.inherent_level] ?? '#adb5bd' }};color:{{ r.inherent_level == 'medium' ? '#1d273b' : '#fff' }}">{{ r.inherent_score }}</span></td>
                      <td><span class="badge" style="background:{{ level_color[r.residual_level] ?? '#adb5bd' }};color:{{ r.residual_level == 'medium' ? '#1d273b' : '#fff' }}">{{ r.residual_score }}</span></td>
                      <td class="small">{{ r.economic_impact_max ? r.economic_impact_max|formatted_number : '-' }}</td></tr>
               {% endfor %}
               </tbody></table></div>
         </div>
      </div>
      <div class="col-lg-5">
         <div class="card mb-3">
            <div class="card-header"><h3 class="card-title">{{ __('Overdue treatment actions', 'erm') }} <span class="badge bg-red-lt ms-2">{{ overdue|length }}</span></h3>
               <div class="card-actions"><a href="{{ actions_url }}?{{ {'criteria': [{'field': 4, 'searchtype': 'lessthan', 'value': 'TODAY'}, {'link': 'AND', 'field': 5, 'searchtype': 'notequals', 'value': 'done'}, {'link': 'AND', 'field': 5, 'searchtype': 'notequals', 'value': 'cancelled'}]}|url_encode }}">{{ __('See all action plans', 'erm') }}</a></div></div>
            <div class="table-responsive"><table class="table card-table table-sm">
               <tbody>
               {% for a in overdue %}
                  <tr><td><a href="{{ risk_url }}?id={{ a.risk_id }}">{{ a.code }}</a></td><td class="small"><a href="{{ actions_form_url }}?id={{ a.id }}" class="text-reset">{{ a.name }}</a></td><td class="small">{{ a.owner }}</td><td><span class="badge bg-red-lt">{{ a.due_date }}</span></td></tr>
               {% else %}<tr><td class="text-muted">{{ __('No overdue actions.', 'erm') }}</td></tr>{% endfor %}
               </tbody></table></div>
         </div>
         <div class="card">
            <div class="card-header"><h3 class="card-title">{{ __('KRIs in alert', 'erm') }} {% if kris|length %}<a href="{{ drill_url }}&kri=1" class="badge bg-orange-lt ms-2">{{ kris|length }}</a>{% endif %}</h3></div>
            <div class="table-responsive"><table class="table card-table table-sm">
               <tbody>
               {% for k in kris %}
                  <tr><td><a href="{{ risk_url }}?id={{ k.risk_id }}">{{ k.risk_code }}</a></td><td class="small">{{ k.name }}</td>
                      <td><span class="badge {{ k.status == 'red' ? 'bg-red-lt' : 'bg-orange-lt' }}">{{ k.last.value|formatted_number }} {{ k.unit }}</span></td></tr>
               {% else %}<tr><td class="text-muted">{{ __('No KRI in alert.', 'erm') }}</td></tr>{% endfor %}
               </tbody></table></div>
         </div>
      </div>
   </div>
</div>
