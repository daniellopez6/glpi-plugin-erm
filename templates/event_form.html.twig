{# Loss event form #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
   {% if link %}
   <div class="alert alert-info col-12"><i class="ti ti-link me-2"></i>{{ __('The event will be linked with: %s', 'erm')|format(link.label) }}</div>
   <input type="hidden" name="_link_itemtype" value="{{ link.itemtype }}">
   <input type="hidden" name="_link_items_id" value="{{ link.items_id }}">
   {% endif %}
   {% if item.isNewItem() %}<input type="hidden" name="entities_id" value="{{ item.fields['entities_id'] }}">{% endif %}

   {{ fields.smallTitle(__('Event', 'erm'), 'ti ti-flame') }}
   {{ fields.textField('name', item.fields['name'], __('Event', 'erm'), {'required': true}) }}
   {{ fields.dropdownArrayField('event_type', item.fields['event_type'] ?: 'loss', types, __('Event type', 'erm'), {'helper': __('Near miss: the event happened but caused no loss. It does not count for the probability but shows that the risk is active.', 'erm')}) }}
   {{ fields.dateField('occurrence_date', item.fields['occurrence_date'], __('Occurrence date', 'erm'), {'required': true}) }}
   {{ fields.dateField('detection_date', item.fields['detection_date'], __('Detection date', 'erm')) }}
   {{ fields.dropdownField('GlpiPlugin\\Erm\\Category', 'plugin_erm_categories_id', item.fields['plugin_erm_categories_id'], __('Category', 'erm'), {'entity': item.fields['entities_id']}) }}
   {{ fields.dropdownArrayField('status', item.fields['status'] ?: 'open', statuses, __('Status', 'erm')) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], __('Reported by', 'erm'), {'right': 'all', 'entity': item.fields['entities_id']}) }}
   {{ fields.textareaField('description', item.fields['description'], __('What happened', 'erm'), {'full_width': true}) }}
   {{ fields.textareaField('root_cause', item.fields['root_cause'], __('Root cause', 'erm'), {'full_width': true}) }}

   {{ fields.smallTitle(__('Economic effect', 'erm'), 'ti ti-cash') }}
   {{ fields.textField('gross_loss', item.fields['gross_loss'], __('Gross loss', 'erm'), {'helper': __('In the currency of the organization.', 'erm')}) }}
   {{ fields.textField('recoveries', item.fields['recoveries'], __('Recoveries', 'erm'), {'helper': __('Insurance, claims, recovered amounts.', 'erm')}) }}
   {{ fields.htmlField('', item.fields['net_loss'] is not null and item.fields['net_loss'] != '' ? '<b>' ~ item.fields['net_loss']|formatted_number ~ '</b>' : '-', __('Net loss', 'erm'), {'helper': __('Calculated: gross loss - recoveries.', 'erm')}) }}
{% endblock %}
