{
    "name": "daniellopez6/glpi-plugin-erm",
    "description": "Enterprise Risk Management (ISO 31000 / COSO ERM) plugin for GLPI",
    "type": "glpi-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "glpi-project/coding-standard": "^0.13",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "GlpiPlugin\\Erm\\": "src/"
        }
    },
    "scripts": {
        "lint": "phpcs -p --standard=.phpcs.xml",
        "analyse": "phpstan analyse -c phpstan.neon"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {"php": "8.2.0"}
    }
}
