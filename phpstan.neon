# Run from a checkout placed in glpi/plugins/erm: vendor/bin/phpstan analyse -c phpstan.neon
parameters:
    level: 5
    paths:
        - src
        - front
        - setup.php
        - hook.php
    bootstrapFiles:
        - ../../vendor/autoload.php
        - ../../src/autoload/constants.php
        - ../../src/autoload/i18n.php
        - ../../src/autoload/misc-functions.php
        - ../../src/autoload/dbutils-aliases.php
        - ../../src/autoload/legacy-autoloader.php
    scanDirectories:
        - ../../src
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # GLPI GRC Manager is an optional dependency, not available during analysis.
        -
            identifier: function.impossibleType
            path: src/Risk_Item.php
